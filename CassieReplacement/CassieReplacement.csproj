<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Configurations>LabApi;Exiled</Configurations>
    <Configuration Condition="'$(Configuration)' == ''">LabApi</Configuration>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Authors>icedchqi</Authors>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <NoWarn>$(NoWarn);NU1902</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'LabApi'">
    <DefineConstants>TRACE</DefineConstants>
    <OutputPath>..\..\..\output\CassieReplacement\</OutputPath>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Exiled'">
    <DefineConstants>TRACE;EXILED;CUSTOMITEM;EXILED_WIP</DefineConstants>
    <OutputPath>..\..\..\output\CassieReplacement\EXILED-WIP\</OutputPath>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SecretLabNAudio.Core" Version="2.1.2">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="NAudio.Core" Version="2.2.1">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="Fody" Version="6.8.2" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.3.3">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Northwood.LabAPI" Version="1.1.7">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="ExMod.Exiled" Version="9.14.2" Condition="$(DefineConstants.Contains('EXILED'))">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp-Publicized">
      <HintPath>$(sl_references)\Assembly-CSharp-Publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(sl_references)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CommandSystem.Core">
      <HintPath>$(sl_references)\CommandSystem.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>$(sl_references)\Mirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Pooling">
      <HintPath>$(sl_references)\Pooling.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NorthwoodLib">
      <HintPath>$(sl_references)\NorthwoodLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(sl_references)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(sl_references)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="YamlDotNet">
      <HintPath>$(sl_references)\YamlDotNet.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="!$(DefineConstants.Contains('EXILED'))">
    <Compile Remove="CassieControllerItem.cs" />
  </ItemGroup>
  <Target Name="CleanupEmbeddedDeps" AfterTargets="Build">
    <ItemGroup>
      <_EmbeddedLoose Include="$(OutputPath)NVorbis.dll" />
      <_EmbeddedLoose Include="$(OutputPath)System.Buffers.dll" />
      <_EmbeddedLoose Include="$(OutputPath)System.Memory.dll" />
      <_EmbeddedLoose Include="$(OutputPath)System.Numerics.Vectors.dll" />
      <_EmbeddedLoose Include="$(OutputPath)System.Runtime.CompilerServices.Unsafe.dll" />
      <_EmbeddedLoose Include="$(OutputPath)System.ValueTuple.dll" />
      <_EmbeddedLoose Include="$(OutputPath)System.Diagnostics.DiagnosticSource.dll" />
      <_EmbeddedLoose Include="$(OutputPath)0Harmony.dll" />
    </ItemGroup>
    <Delete Files="@(_EmbeddedLoose)" TreatErrorsAsWarnings="true" />
  </Target>
</Project>
